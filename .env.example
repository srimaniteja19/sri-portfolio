# Google AI Studio - Gemini 2.5 Flash (free: 15 req/min, 1000/day)
# For AI Portfolio Assistant & JD Matcher on /hire
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Portfolio admin dashboard (/admin) – set a password only you know
# In development, edits are saved to src/data/portfolio-content.json
ADMIN_SECRET=your_admin_password_here

# Optional: for production, add a Redis store (e.g. Upstash via Vercel) and set:
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
# Then edits from /admin will persist without redeploying.
